			SIMP H 2 A_Pain
		goto See
	
		Pain.Head:
			SIMP H 2
			SIMP H 2 A_Pain
		goto See
		
		Pain.Shrapnel:
			SIMP H 2
			SIMP H 2 A_Pain
		goto See
		
